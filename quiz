            : "Begriffspaar",
          idea: record.idea
        }));

      const savedIntroductions = Object.entries(
        state.station3.getToKnow.answers || {}
      )
        .filter(([, record]) => record && record.answer)
        .map(([index, record]) => ({
          question:
            GET_TO_KNOW_QUESTIONS[Number(index)] || "Kennenlernfrage",
          answer: record.answer
        }));

      screenElement.innerHTML = `
        <div class="card">
          <p class="eyebrow">Et hätt noch immer jot jejange</p>
          <h1>Tour geschafft!</h1>
          <p class="lead">
            ${getFinishMessage(totalScore)}
          </p>

          <div class="summary-grid">
            <div class="summary-box">
              <strong>${totalScore}</strong>
              Gesamtpunkte
            </div>
            <div class="summary-box">
              <strong>${getCompletedWayTasks()}</strong>
              Wegaufgaben erledigt
            </div>
            <div class="summary-box">
              <strong>${state.completedStations.length}</strong>
              Stationen abgeschlossen
            </div>
          </div>

          <button id="toggle-results" class="secondary full" type="button" aria-expanded="${state.resultsVisible}">
            Ergebnisse ${state.resultsVisible ? "ausblenden" : "einblenden"}
          </button>

          <div id="result-details" class="result-details${state.resultsVisible ? "" : " hidden"}">
            <div class="result-section">
              <h3>Punkte nach Stationen</h3>
              <ul>
                <li><strong>Päffgen:</strong> ${getStationScore(1)} Punkte</li>
                <li><strong>Brunne von Kölle:</strong> ${getStationScore(2)} Punkte</li>
                <li><strong>Zappes:</strong> Teamgeist statt Punktedruck</li>
              </ul>
            </div>

            <div class="result-section">
              <h3>Gespeicherte Synergie-Ideen</h3>
              ${savedSynergies.length ? `
                <ul>
                  ${savedSynergies.map((entry) => `
                    <li>
                      <strong>${escapeHTML(entry.pair)}:</strong>
                      ${escapeHTML(entry.idea)}
                    </li>
                  `).join("")}
                </ul>
              ` : `
                <p>Keine Synergie-Ideen gespeichert. Die besten Gedanken bleiben manchmal ohnehin am Tisch.</p>
              `}
            </div>

            <div class="result-section">
              <h3>Gespeicherte Kennenlernantworten</h3>
              ${savedIntroductions.length ? `
                <ul>
                  ${savedIntroductions.map((entry) => `
                    <li>
                      <strong>${escapeHTML(entry.question)}</strong><br>
                      ${escapeHTML(entry.answer)}
                    </li>
                  `).join("")}
                </ul>
              ` : `
                <p>Keine Kennenlernantworten gespeichert.</p>
              `}
            </div>

            ${renderVoteResultsHTML()}

            <div class="privacy-note" style="margin-top:16px">
              Diese Ergebnisse werden ausschließlich auf dem aktuellen Gerät angezeigt.
              Es gibt keinen Versand, kein Tracking und keine öffentliche Rangliste.
            </div>
          </div>

          <div class="button-row">
            <button id="restart-tour" class="primary" type="button">
              Tour neu starten
            </button>
            <button id="overview-button" class="ghost" type="button">
              Zur Stationsübersicht
            </button>
          </div>
        </div>
      `;

      document.getElementById("toggle-results").addEventListener("click", () => {
        state.resultsVisible = !state.resultsVisible;
        saveState();
        renderFinish();
      });

      document.getElementById("restart-tour").addEventListener("click", () => {
        const confirmed = window.confirm(
          "Möchtet ihr die Tour wirklich neu starten? Alle lokal gespeicherten Antworten und Punkte werden gelöscht."
        );

        if (confirmed) {
          resetState();
        }
      });

      document.getElementById("overview-button").addEventListener("click", () => {
        setScreen("station-overview", 3);
      });

      if (!state.confettiShown) {
        state.confettiShown = true;
        saveState();
        createConfetti();
      }
    }

    function getFinishMessage(score) {
      if (score >= 9) {
        return "Domhoch überlegen, aber angenehm unangeberisch. Ihr seid offiziell köln-tourtauglich.";
      }

      if (score >= 6) {
        return "Starkes Teamwissen, gute Ideen und ausreichend kölsche Gelassenheit.";
      }

      return "Nicht jede Antwort saß, aber die Gruppe schon. Genau so gewinnt man eine Köln-Tour.";
    }

    function createConfetti() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }

      confettiLayer.innerHTML = "";

      const colors = ["#b5122b", "#ffffff", "#292b2f", "#e85d70", "#f3c44e"];

      for (let index = 0; index < 42; index += 1) {
        const piece = document.createElement("span");
        piece.className = "confetti";
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[index % colors.length];
        piece.style.animationDelay = `${Math.random() * 0.5}s`;
        piece.style.animationDuration = `${2.2 + Math.random() * 1.5}s`;
        piece.style.setProperty("--drift", `${-80 + Math.random() * 160}px`);
        piece.style.transform = `rotate(${Math.random() * 180}deg)`;
        confettiLayer.appendChild(piece);
      }

      window.setTimeout(() => {
        confettiLayer.innerHTML = "";
      }, 4500);
    }

    /* =========================
       Globale Navigation
       ========================= */

    stationNavigation.addEventListener("click", (event) => {
      const button = event.target.closest('[data-action="open-station"]');

      if (!button) {
        return;
      }

      const stationId = Number(button.dataset.station);

      if (
        Number.isInteger(stationId) &&
        stationId >= 1 &&
        stationId <= state.unlockedStation
      ) {
        setScreen("station", stationId);
      }
    });

    document.getElementById("reset-tour").addEventListener("click", () => {
      const confirmed = window.confirm(
        "Möchtet ihr die Tour wirklich zurücksetzen? Alle lokal gespeicherten Antworten, Punkte und Fortschritte werden gelöscht."
      );

      if (confirmed) {
        resetState();
      }
    });

    render();
  </script>
</body>
</html>
