          <div class="vote-results">
            ${PEOPLE.map((name) => {
              const count = counts[name];
              const width = Math.round((count / maximum) * 100);

              return `
                <div class="vote-row">
                  <span>${escapeHTML(name)}</span>
                  <div class="vote-track" aria-hidden="true">
                    <div class="vote-fill" style="width:${width}%"></div>
                  </div>
                  <strong>${count}</strong>
                </div>
              `;
            }).join("")}
          </div>
        </div>
      `;
    }

