    function getVoteCounts() {
      const counts = Object.fromEntries(PEOPLE.map((name) => [name, 0]));

      Object.values(state.station3.mostLikely.votes || {}).forEach((vote) => {
        if (
          vote &&
          vote.confirmed &&
          !vote.skipped &&
          PEOPLE.includes(vote.name)
        ) {
          counts[vote.name] += 1;
        }
      });

      return counts;
    }

    function renderVoteResultsHTML() {
      const counts = getVoteCounts();
      const maximum = Math.max(1, ...Object.values(counts));
      const totalVotes = Object.values(counts).reduce(
        (sum, count) => sum + count,
        0
      );

      if (totalVotes === 0) {
        return `
          <div class="result-section">
            <h3>Lokale Spaßauswertung</h3>
            <p>Es wurden keine Namen bestätigt. Auch das ist vollkommen in Ordnung.</p>
