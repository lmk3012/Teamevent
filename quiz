    function answerKnowledgeQuestion(optionIndex) {
      const stationId = state.currentStation;
      const stationState = state.knowledge[stationId];
      const index = stationState.index;
      const question = KNOWLEDGE_QUESTIONS[stationId][index];

      if (
        stationState.answers[index] ||
        !Number.isInteger(optionIndex) ||
        optionIndex < 0 ||
        optionIndex >= question.options.length
      ) {
        return;
      }

      stationState.answers[index] = {
        selected: optionIndex,
        correct: question.fun ? false : optionIndex === question.correct,
        fun: Boolean(question.fun)
      };

      saveState();
      render();
    }

    function knowledgeFeedbackHTML(question, answer) {
      if (question.fun) {
        return `
          <div class="feedback">
            <strong>Großartige Diagnose.</strong>
            <p>${escapeHTML(question.explanations[answer.selected])}</p>
            <p>Das war eine Spaßfrage und gibt keinen Wissenspunkt.</p>
          </div>
        `;
      }

      return `
        <div class="feedback ${answer.correct ? "success" : "warning"}">
          <strong>${answer.correct ? "Richtig! Ein Punkt für das Team." : "Knapp daneben, aber kölsch gelassen bleiben."}</strong>
          <p>${escapeHTML(question.explanation)}</p>
        </div>
      `;
    }

