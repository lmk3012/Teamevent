    function loadState() {
      const fallback = createInitialState();

      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          return fallback;
        }

        const saved = JSON.parse(raw);
        return mergeState(fallback, saved);
      } catch (error) {
        return fallback;
      }
    }

    function mergeState(base, saved) {
      if (!saved || typeof saved !== "object") {
        return base;
      }

      return {
        ...base,
        ...saved,
        knowledge: {
          1: {
            ...base.knowledge[1],
            ...(saved.knowledge && saved.knowledge[1] ? saved.knowledge[1] : {})
          },
          2: {
            ...base.knowledge[2],
            ...(saved.knowledge && saved.knowledge[2] ? saved.knowledge[2] : {})
          }
        },
        cologneTerms: {
          ...base.cologneTerms,
          ...(saved.cologneTerms || {})
        },
        synergies: {
          ...base.synergies,
          ...(saved.synergies || {})
        },
        station3: {
          ...base.station3,
          ...(saved.station3 || {}),
          getToKnow: {
            ...base.station3.getToKnow,
            ...(saved.station3 && saved.station3.getToKnow
              ? saved.station3.getToKnow
              : {})
          },
          mostLikely: {
            ...base.station3.mostLikely,
            ...(saved.station3 && saved.station3.mostLikely
              ? saved.station3.mostLikely
              : {})
          }
        }
      };
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (error) {
        /* Das Quiz funktioniert auch ohne lokalen Speicher weiter. */
      }
    }

    function resetState() {
