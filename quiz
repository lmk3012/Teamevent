    function escapeHTML(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function normalizeText(value) {
      return String(value ?? "")
        .trim()
        .toLocaleLowerCase("de-DE")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/ß/g, "ss")
        .replace(/[.,!?;:()[\]{}"'´`]/g, "")
        .replace(/\s+/g, " ");
    }

    function isAccepted(input, accepted) {
      const normalizedInput = normalizeText(input);

      return accepted.some((solution) => {
        const normalizedSolution = normalizeText(solution);
        return (
          normalizedInput === normalizedSolution ||
          normalizedInput.includes(normalizedSolution) ||
          normalizedSolution.includes(normalizedInput)
        );
      });
    }

    function getScore() {
      let score = 0;

      [1, 2].forEach((stationId) => {
        Object.values(state.knowledge[stationId].answers || {}).forEach((answer) => {
          if (answer && answer.correct === true && answer.fun !== true) {
            score += 1;
          }
        });
      });

      if (state.cologneTerms.pointAwarded) {
        score += 1;
      }

      if (state.synergies.pointAwarded) {
        score += 1;
      }

      return score;
    }

    function getStationScore(stationId) {
      let score = 0;

      if (state.knowledge[stationId]) {
        Object.values(state.knowledge[stationId].answers || {}).forEach((answer) => {
          if (answer && answer.correct === true && answer.fun !== true) {
            score += 1;
          }
        });
      }

      if (stationId === 1 && state.cologneTerms.pointAwarded) {
        score += 1;
      }

      if (stationId === 2 && state.synergies.pointAwarded) {
        score += 1;
      }

      return score;
    }

    function getCompletedWayTasks() {
      let count = 0;

      if (state.cologneTerms.complete) {
        count += 1;
      }

      if (state.synergies.complete) {
        count += 1;
      }

      return count;
    }

    function getProgress() {
      if (!state.started) {
        return { value: 0, label: "Start" };
      }

      if (state.screen === "finish") {
        return { value: 100, label: "Tour geschafft" };
      }

      const stationOneKnowledge =
        Object.keys(state.knowledge[1].answers || {}).length /
        KNOWLEDGE_QUESTIONS[1].length;
      const terms =
        Object.keys(state.cologneTerms.records || {}).length /
        COLOGNE_TERMS.length;
      const stationTwoKnowledge =
        Object.keys(state.knowledge[2].answers || {}).length /
        KNOWLEDGE_QUESTIONS[2].length;
      const synergies =
        Object.keys(state.synergies.records || {}).length /
        SYNERGY_PAIRS.length;

      const modeProgress =
        state.station3.mode === "mostLikely"
          ? Object.keys(state.station3.mostLikely.votes || {}).length /
            MOST_LIKELY_QUESTIONS.length
          : Object.keys(state.station3.getToKnow.answers || {}).length /
            GET_TO_KNOW_QUESTIONS.length;

      const value = Math.round(
        ((stationOneKnowledge + terms + stationTwoKnowledge + synergies + modeProgress) /
          5) *
          100
      );

      const activeStation = STATIONS.find(
        (station) => station.id === state.currentStation
      );

      return {
        value: Math.max(0, Math.min(100, value)),
        label: activeStation
          ? `Station ${activeStation.id}: ${activeStation.name}`
          : "Tourfortschritt"
      };
    }

    function updateChrome() {
      scoreElement.textContent = String(getScore());

      progressArea.classList.toggle("hidden", !state.started);
      stationNavigation.classList.toggle("hidden", !state.started);

      const progress = getProgress();
      progressFill.style.width = `${progress.value}%`;
      progressLabel.textContent = progress.label;
      progressPercent.textContent = `${progress.value} %`;
      progressTrack.setAttribute("aria-valuenow", String(progress.value));

      renderStationNavigation();
    }

    function renderStationNavigation() {
      if (!state.started) {
        stationNavigation.innerHTML = "";
        return;
      }

      stationNavigation.innerHTML = STATIONS.map((station) => {
        const complete = state.completedStations.includes(station.id);
        const locked = station.id > state.unlockedStation;
        const active =
          state.screen !== "finish" && state.currentStation === station.id;

        return `
          <button
            type="button"
            class="station-tab${active ? " active" : ""}${complete ? " complete" : ""}${locked ? " locked" : ""}"
            data-action="open-station"
            data-station="${station.id}"
            ${locked ? "disabled" : ""}
            aria-current="${active ? "step" : "false"}"
            aria-label="Station ${station.id}: ${escapeHTML(station.name)}${complete ? ", abgeschlossen" : ""}${locked ? ", gesperrt" : ""}"
          >
            ${station.id}. ${escapeHTML(station.name)}
          </button>
        `;
      }).join("");
    }

    function scrollToQuizStart() {
      window.requestAnimationFrame(() => {
        document.getElementById("quiz-root").scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start"
        });

        screenElement.focus({ preventScroll: true });
      });
    }

    function setScreen(screen, stationId) {
      state.screen = screen;

      if (stationId) {
        state.currentStation = stationId;
      }

      saveState();
      render();
      scrollToQuizStart();
    }

    function completeStation(stationId) {
      if (!state.completedStations.includes(stationId)) {
        state.completedStations.push(stationId);
      }

      state.unlockedStation = Math.max(
        state.unlockedStation,
        Math.min(3, stationId + 1)
      );

      saveState();
    }

    function stationHeader(stationId) {
      const station = STATIONS.find((item) => item.id === stationId);

      return `
